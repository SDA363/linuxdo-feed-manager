(() => {
  const DB_NAME = "ldfc";
  const DB_VERSION = 1;
  const TOPICS_STORE = "topics";
  const META_STORE = "meta";

  let dbPromise = null;

  function openDatabase() {
    if (dbPromise) return dbPromise;

    dbPromise = new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, DB_VERSION);

      request.onupgradeneeded = () => {
        const database = request.result;
        if (!database.objectStoreNames.contains(TOPICS_STORE)) {
          database.createObjectStore(TOPICS_STORE, { keyPath: "topicId" });
        }
        if (!database.objectStoreNames.contains(META_STORE)) {
          database.createObjectStore(META_STORE);
        }
      };

      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });

    return dbPromise;
  }

  function requestToPromise(request) {
    return new Promise((resolve, reject) => {
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }

  async function withStore(storeName, mode, callback) {
    const database = await openDatabase();
    const transaction = database.transaction(storeName, mode);
    const store = transaction.objectStore(storeName);
    const result = await callback(store);
    await requestToPromise(transaction);
    return result;
  }

  window.LDFCDB = {
    async getAllTopics() {
      return withStore(TOPICS_STORE, "readonly", (store) =>
        requestToPromise(store.getAll())
      );
    },

    async getTopic(topicId) {
      return withStore(TOPICS_STORE, "readonly", (store) =>
        requestToPromise(store.get(String(topicId)))
      );
    },

    async putTopic(record) {
      return withStore(TOPICS_STORE, "readwrite", (store) =>
        requestToPromise(store.put(record))
      );
    },

    async clearTopics() {
      return withStore(TOPICS_STORE, "readwrite", (store) =>
        requestToPromise(store.clear())
      );
    },

    async getMeta(key) {
      return withStore(META_STORE, "readonly", (store) =>
        requestToPromise(store.get(key))
      );
    },

    async putMeta(key, value) {
      return withStore(META_STORE, "readwrite", (store) =>
        requestToPromise(store.put(value, key))
      );
    }
  };
})();
